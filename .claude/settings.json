{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/claude_memory_hook.py\" --config \"${CLAUDE_PROJECT_DIR}/.jason-memory.json\" --jason-hook",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/claude_memory_hook.py\" --config \"${CLAUDE_PROJECT_DIR}/.jason-memory.json\" --jason-hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/claude_memory_hook.py\" --config \"${CLAUDE_PROJECT_DIR}/.jason-memory.json\" --jason-hook",
            "timeout": 15
          }
        ],
        "matcher": "Read|Write|Edit|MultiEdit"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/claude_memory_hook.py\" --config \"${CLAUDE_PROJECT_DIR}/.jason-memory.json\" --jason-hook",
            "timeout": 15
          }
        ],
        "matcher": "Bash|PowerShell|powershell"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/claude_memory_hook.py\" --config \"${CLAUDE_PROJECT_DIR}/.jason-memory.json\" --jason-hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
